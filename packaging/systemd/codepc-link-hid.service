[Unit]
Description=CodePC Link vendor HID status server
Documentation=https://github.com/ami3go/codepc-link
Requires=bluetooth.service NetworkManager.service
After=bluetooth.service NetworkManager.service
PartOf=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/codepc-link-hid serve --state-dir /var/lib/codepc-link-hid --interval 5
Restart=always
RestartSec=2s

# hidraw nodes are usually root-owned and appear dynamically when the Android
# HID profile connects. Keep this prototype service as root, expose the real
# /dev tree, and remove all ambient capabilities. A dedicated udev/group policy
# can replace root after hardware validation.
StateDirectory=codepc-link-hid
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
